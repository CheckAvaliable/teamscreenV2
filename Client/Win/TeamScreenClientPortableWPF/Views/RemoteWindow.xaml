<Window x:Class="TeamScreenClientPortableWPF.Views.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TeamScreenClientPortableWPF.Views"
        mc:Ignorable="d"
        Title="Host: " Height="600" Width="800"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Content="Ctrl+Alt+Del" 
                    Click="BtnCtrlAltDel_Click" 
                    Margin="5"/>
            <Label Content="Key:" Margin="10,0,0,0"/>
            <TextBox x:Name="txtKeyCode" 
                     Text="46" 
                     Width="60" 
                     Margin="5"
                     MaxLength="3"/>
            <Button Content="Send Key" 
                    Click="BtnSendKey_Click" 
                    Margin="5"/>
            <Button Content="Close" 
                    Click="BtnClose_Click" 
                    Margin="20,0,0,0"/>
        </ToolBar>

        <!-- Drawing Area - Using a ScrollViewer to handle large images -->
        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto">
            <Border Background="Azure" 
                    Name="drawingAreaBorder" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top">
                <Image x:Name="remoteImage" 
                       Stretch="None"/>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>